{
  "info": {
    "_postman_id": "pharmacy-api-rbac-jwt-collection",
    "name": "Pharmacy Management & Medicine Ordering REST API",
    "description": "Postman Collection for Assignment 09 - Pharmacy & Healthcare Store REST API with RBAC & JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "pharmacistToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "medicineId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication Routes",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Customer\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"9876543210\",\n  \"address\": \"456 Market St, City\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Register Staff (Pharmacist)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Pharmacist\",\n  \"email\": \"pharmacist@example.com\",\n  \"password\": \"pharmacist123\",\n  \"role\": \"pharmacist\",\n  \"adminKey\": \"admin_secret_pharmacy_key_2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register-staff",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register-staff"]
            }
          }
        },
        {
          "name": "Register Staff (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Admin\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\",\n  \"role\": \"admin\",\n  \"adminKey\": \"admin_secret_pharmacy_key_2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register-staff",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register-staff"]
            }
          }
        },
        {
          "name": "Login (Customer / Staff)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Medicine Inventory Routes",
      "item": [
        {
          "name": "Browse Medicine Catalog (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/medicines?category=Antibiotic",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medicines"],
              "query": [
                {
                  "key": "category",
                  "value": "Antibiotic"
                },
                {
                  "key": "search",
                  "value": "Amoxicillin",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Add Medicine (Customer - Expect 403 Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Forbidden Drug\",\n  \"brand\": \"IllegalBrand\",\n  \"category\": \"Narcotic\",\n  \"dosageForm\": \"Tablet\",\n  \"price\": 100,\n  \"stockQuantity\": 10,\n  \"expiryDate\": \"2026-12-31\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/medicines",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medicines"]
            }
          }
        },
        {
          "name": "Add Medicine (Pharmacist / Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amoxicillin 500mg\",\n  \"brand\": \"PharmaCare\",\n  \"category\": \"Antibiotic\",\n  \"dosageForm\": \"Capsule\",\n  \"price\": 12.50,\n  \"stockQuantity\": 100,\n  \"requiresPrescription\": true,\n  \"expiryDate\": \"2026-10-01T00:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/medicines",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medicines"]
            }
          }
        },
        {
          "name": "Query Expiring Medicines (Pharmacist / Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/medicines/expiring",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medicines", "expiring"]
            }
          }
        },
        {
          "name": "Query Expiring Soon Report (Pharmacist / Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/expiring-soon",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "expiring-soon"]
            }
          }
        },
        {
          "name": "Update Stock / Price (Pharmacist / Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 14.00,\n  \"stockQuantity\": 150\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/medicines/{{medicineId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medicines", "{{medicineId}}"]
            }
          }
        },
        {
          "name": "Delete Medicine (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/medicines/{{medicineId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medicines", "{{medicineId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Order & Prescription Routes",
      "item": [
        {
          "name": "Place Order (Customer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"medicine\": \"{{medicineId}}\",\n      \"quantity\": 2\n    }\n  ],\n  \"prescriptionNotes\": \"Doctor prescription attached\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "View My Orders (Customer)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "my-orders"]
            }
          }
        },
        {
          "name": "List All Orders (Pharmacist / Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          }
        },
        {
          "name": "Approve / Dispense Order & Trigger Stock Deduction (Pharmacist / Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}", "status"]
            }
          }
        }
      ]
    }
  ]
}
